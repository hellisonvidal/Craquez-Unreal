{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0.0",
  "FriendlyName": "FootballCore",
  "Description": "Core football gameplay systems for Craquez - Ball physics, Player AI, Networking, UI",
  "Category": "Gameplay",
  "CreatedBy": "Craquez Team",
  "CreatedByURL": "https://github.com/hellisonvidal/Craquez-Unreal",
  "DocsURL": "",
  "MarketplaceURL": "",
  "SupportURL": "",
  "CanContainContent": true,
  "IsBetaVersion": false,
  "IsExperimentalVersion": false,
  "Installed": false,
  "Modules": [
    {
      "Name": "FootballCore",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64", "Mac", "Linux", "Android", "IOS"]
    },
    {
      "Name": "FootballCoreGameplay",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64", "Mac", "Linux", "Android", "IOS"],
      "AdditionalDependencies": ["FootballCore"]
    },
    {
      "Name": "FootballCoreAI",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64", "Mac", "Linux", "Android", "IOS"],
      "AdditionalDependencies": ["FootballCore", "FootballCoreGameplay", "AIModule", "GameplayTasks"]
    },
    {
      "Name": "FootballCoreNetworking",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64", "Mac", "Linux", "Android", "IOS"],
      "AdditionalDependencies": ["FootballCore", "FootballCoreGameplay", "NetCore"]
    },
    {
      "Name": "FootballCoreUI",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "PlatformAllowList": ["Win64", "Mac", "Linux", "Android", "IOS"],
      "AdditionalDependencies": ["FootballCore", "FootballCoreGameplay", "FootballCoreNetworking", "UMG", "Slate", "SlateCore"]
    }
  ],
  "Plugins": [
    {
      "Name": "EnhancedInput",
      "Enabled": true
    },
    {
      "Name": "Niagara",
      "Enabled": true
    },
    {
      "Name": "ControlRig",
      "Enabled": true
    },
    {
      "Name": "StateTree",
      "Enabled": true
    },
    {
      "Name": "GameplayStateTree",
      "Enabled": true
    }
  ],
  "SupportedTargetPlatforms": ["Win64", "Mac", "Linux", "Android", "IOS"]
}
